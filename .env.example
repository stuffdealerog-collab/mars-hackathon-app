# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# ---------- Supabase (the server talks to the DB with the service role key only) ----------
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key (not used by the server today; safe to expose to browsers)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key. SERVER ONLY: bypasses RLS, never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Database password (only needed locally for `supabase link` / `supabase db push`)
SUPABASE_DB_PASSWORD=

# ---------- Telegram ----------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for t.me links, the landing page and /qr)
BOT_USERNAME=
# Random 16-256 chars (A-Z a-z 0-9 _ -). Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional: text of the chat menu button that opens the Mini App (default "Open")
MENU_BUTTON_TEXT=

# ---------- App ----------
# Public https origin of the production deployment, no trailing slash
PUBLIC_URL=

# ---------- Claude (optional) ----------
# Without a key the bot answers with a friendly fallback message.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=
