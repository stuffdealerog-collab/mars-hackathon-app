# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# ---------- Database (Neon Postgres, added via the Vercel Marketplace) ----------
# On Vercel these are created and managed by the Neon integration: do not add them by hand
# (pnpm env:push skips them). Locally, pull them without touching your other secrets:
#   vercel env pull .env.neon --environment=production --yes
#   copy the DATABASE_URL and DATABASE_URL_UNPOOLED lines into .env.local, then delete .env.neon
# Pooled connection string, used by the app at runtime. SERVER ONLY.
DATABASE_URL=
# Direct (unpooled) connection string, used by `pnpm db:migrate`. SERVER ONLY.
DATABASE_URL_UNPOOLED=

# ---------- Telegram ----------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for t.me links, the landing page and /qr)
BOT_USERNAME=
# Random 16-256 chars (A-Z a-z 0-9 _ -). Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional: text of the chat menu button that opens the Mini App (default "Open")
MENU_BUTTON_TEXT=

# ---------- App ----------
# Public https origin of the production deployment, no trailing slash
PUBLIC_URL=

# ---------- Claude (optional) ----------
# Without a key the bot answers with a friendly fallback message.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=
