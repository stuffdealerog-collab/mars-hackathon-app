# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# ---------- Database (Neon Postgres, added via the Vercel Marketplace) ----------
# On Vercel these are created and managed by the Neon integration: do not add them by hand
# (pnpm env:push skips them). Locally, pull them without touching your other secrets:
#   vercel env pull .env.neon --environment=production --yes
#   copy the DATABASE_URL and DATABASE_URL_UNPOOLED lines into .env.local, then delete .env.neon
# Pooled connection string, used by the app at runtime. SERVER ONLY.
DATABASE_URL=
# Direct (unpooled) connection string, used by `pnpm db:migrate`. SERVER ONLY.
DATABASE_URL_UNPOOLED=

# ---------- Telegram ----------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for t.me links, the landing page and /qr)
BOT_USERNAME=
# Random 16-256 chars (A-Z a-z 0-9 _ -). Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Optional: text of the chat menu button that opens the Mini App (default "Open")
MENU_BUTTON_TEXT=

# ---------- App ----------
# Public https origin of the production deployment, no trailing slash
PUBLIC_URL=

# ---------- Visit counters (optional) ----------
# Public ids, not secrets. NEXT_PUBLIC_* values are inlined at build time: redeploy after a change.
# Empty = that counter is not loaded. They run on Vercel production deployments only
# (NEXT_PUBLIC_VERCEL_ENV=production) and on the landing page only: never in the Studio or the Mini App.
# Google Analytics 4 measurement id, "G-XXXXXXXXXX"
NEXT_PUBLIC_GA_ID=
# Yandex Metrica counter number, digits only
NEXT_PUBLIC_YM_ID=

# ---------- Claude (optional) ----------
# Without a key the bot answers with a friendly fallback message.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
ANTHROPIC_MODEL=

# --- Media pipeline (optional; without keys the media routes answer "not configured")
# Higgsfield developer API: "<key id>:<key secret>" from cloud.higgsfield.ai
# (or set HF_API_KEY + HF_API_SECRET instead)
HIGGSFIELD_API_KEY=
# fal.ai key
FAL_KEY=
# Optional model path overrides for the media providers
HIGGSFIELD_VIDEO_MODEL=
HIGGSFIELD_IMAGE_MODEL=
FAL_VIDEO_MODEL=
FAL_IMAGE_MODEL=
# Provider preference order, default "higgsfield,fal"
MEDIA_PROVIDERS=
# Spend limits: jobs per 24 h for the whole app / per Telegram user / for anonymous web callers
MEDIA_DAILY_LIMIT=
MEDIA_USER_DAILY_LIMIT=
MEDIA_ANON_DAILY_LIMIT=
# "1" = offline demo provider (pre-rendered clips, labelled "namuna")
MEDIA_DEMO=

# ---------- Live stats page (/stats) ----------
# Password for /stats (HTTP Basic auth; any user name, e.g. "mercat"). SERVER ONLY.
# Unset in production = /stats answers 404. Unset locally = /stats is open.
STATS_PASSWORD=
# Telegram user ids of the team, comma-separated (e.g. 12345678,23456789): /stats leaves their traffic out.
STATS_TEAM_TG_IDS=

# ---------- Tick: scheduled work (autopilot publishing, snapshots, sweeps) ----------
# Bearer token for /api/cron/tick, 32-256 chars of A-Z a-z 0-9 _ - + / = . ~ (e.g. `openssl rand -hex 32`). SERVER ONLY.
# Put the same value in Vercel (Production) and in the GitHub repo secret CRON_SECRET; never paste it into a chat.
# Vercel Cron sends it on its own. Unset = the tick runs nothing (it only answers a health check).
# The GitHub workflow (.github/workflows/tick.yml) also needs the repo VARIABLE (not secret)
# TICK_URL = https://<production domain>/api/cron/tick
CRON_SECRET=

# ---------- Team alerts ----------
# Telegram chat for team alerts (fal balance, failed publishes, tick errors): a private group with the bot in it
# (id -100...) or your own user id after you /start the bot. Numeric id only.
OPS_CHAT_ID=

# ---------- Labs routes ----------
# Routes no screen calls yet (radar, video, department, ...) are off unless listed here: comma-separated route
# names (e.g. radar,video) or "all". Unset = all labs routes are off.
LABS_ROUTES=

# ---------- Connectors (read-only insights; set in Vercel Production only) ----------
# Key that encrypts connector tokens at rest: base64 of 32 random bytes (`openssl rand -base64 32`). SERVER ONLY.
# Changing it makes every stored token unreadable (owners reconnect).
CONNECTOR_TOKEN_KEY=
# Meta app (developers.facebook.com, Facebook Login for Business): Instagram insights and Meta ads. SERVER ONLY.
META_APP_ID=
META_APP_SECRET=
# One Google Cloud OAuth client, type "Web application", for YouTube and Google Ads. SERVER ONLY.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads API developer token (API Center of a Google Ads manager account). SERVER ONLY.
GOOGLE_ADS_DEVELOPER_TOKEN=
